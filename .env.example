# Copy to .env and edit. Every variable is optional; defaults are shown.
# All settings are validated by pydantic-settings at startup.

# --- identity ---------------------------------------------------------------
APP_PROJECT_NAME="FastAPI Hello"
APP_VERSION="0.1.0"

# local | test | staging | production
APP_ENVIRONMENT=local
APP_DEBUG=false

# --- server -----------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000

# --- api --------------------------------------------------------------------
APP_API_V1_PREFIX=/api/v1
# Set false in production to hide /docs, /redoc and /openapi.json
APP_DOCS_ENABLED=true

# --- logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# false gives human-readable lines, better for local development
APP_LOG_JSON=true

# --- behaviour --------------------------------------------------------------
APP_DEFAULT_LOCALE=en

# JSON array. Leave empty to disable CORS entirely.
# APP_CORS_ORIGINS=["https://example.com","https://app.example.com"]
